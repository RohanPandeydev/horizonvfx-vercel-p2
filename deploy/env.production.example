# Template for /srv/horizonvfx/.env.production on the VPS.
# COPY this to .env.production and fill in REAL values. NEVER commit the real file.
# Generate strong values with `node scripts/generate-secrets.js` from the repo.

# --- MySQL container vars ---
MYSQL_ROOT_PASSWORD=replace-with-long-random-string
MYSQL_DATABASE=horizonvfx
MYSQL_USER=horizonvfx
MYSQL_PASSWORD=replace-with-different-long-random-string

# --- Next.js app config ---
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Must match MYSQL_USER / MYSQL_PASSWORD above. Host is the compose service name `db`.
DATABASE_URL="mysql://horizonvfx:replace-with-different-long-random-string@db:3306/horizonvfx"

# Public site URL — used for absolute URLs returned by the API (e.g. /uploads/*).
FRONTEND_URL=https://horizonvfx.in

# Uploads go to a volume mounted at this path inside the container.
UPLOAD_DIR=/app/public/uploads

# --- Secrets (regenerate fresh — do NOT reuse the cPanel-era values) ---
JWT_ACCESS_SECRET=replace-with-generate-secrets-output
JWT_REFRESH_SECRET=replace-with-different-generate-secrets-output
ENCRYPTION_SECRET=replace-with-exactly-32-char-string-here
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# --- SMTP for forgot-password emails (optional; can fill later) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@horizonvfx.in

# --- S3 (DISABLED — empty values trigger local-filesystem mode in lib/storage.ts) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=
