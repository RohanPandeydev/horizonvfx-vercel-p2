# Lives on the VPS at /srv/horizonvfx/Caddyfile
# Caddy handles TLS automatically via Let's Encrypt once DNS points here.

www.horizonvfx.in {
    redir https://horizonvfx.in{uri} permanent
}

horizonvfx.in {
    encode gzip zstd

    # Serve uploaded media directly from the host volume (bypasses Node).
    handle_path /uploads/* {
        root * /srv/uploads
        file_server
    }

    # Everything else → Next.js standalone server in the `app` container.
    reverse_proxy app:3000 {
        header_up X-Forwarded-Proto {scheme}
        header_up X-Real-IP {remote_host}
    }
}

# Webmail proxy → cPanel Roundcube on the external mail server.
# Lets users access /webmail at a clean HTTPS URL with a real cert
# instead of http://mail.horizonvfx.in:2096 (mixed-content + ugly port).
# Mail (MX/A) DNS records are intentionally unchanged.
webmail.horizonvfx.in {
    encode gzip zstd
    reverse_proxy https://mail.horizonvfx.in:2096 {
        header_up Host {host}:2096
        transport http {
            tls
            tls_insecure_skip_verify
        }
    }
}
