# Lives on the VPS at /srv/horizonvfx/Caddyfile
# Caddy handles TLS automatically via Let's Encrypt once DNS points here.

www.horizonvfx.in {
    redir https://horizonvfx.in{uri} permanent
}

horizonvfx.in {
    encode gzip zstd

    # Serve uploaded media directly from the host volume (bypasses Node).
    handle_path /uploads/* {
        root * /srv/uploads
        file_server
    }

    # Everything else → Next.js standalone server in the `app` container.
    reverse_proxy app:3000 {
        header_up X-Forwarded-Proto {scheme}
        header_up X-Real-IP {remote_host}
    }
}

# Webmail proxy → CyberPanel SnappyMail running on this host (port 8090).
# Gives a clean https://webmail.horizonvfx.in URL with a valid Let's Encrypt
# cert instead of the self-signed IP:8090/snappymail. host.docker.internal
# resolves to the host gateway (see extra_hosts on the caddy service).
webmail.horizonvfx.in {
    encode gzip zstd
    redir / /snappymail/ 302
    reverse_proxy https://host.docker.internal:8090 {
        transport http {
            tls
            tls_insecure_skip_verify
        }
    }
}
